# ============================================================
# StreamFusion PostgreSQL Torznab Indexer
# ============================================================

# PostgreSQL
# Remplacer USER, PASSWORD, HOST et DATABASE selon votre installation.
DATABASE_URL=postgresql+asyncpg://streamfusion:PASSWORD@postgresql:5432/streamfusion

# Nom affiché dans Prowlarr
INDEXER_NAME=StreamFusion PostgreSQL

# Clé utilisée par Prowlarr pour accéder à l'indexeur.
# Génération recommandée :
# openssl rand -hex 32
INDEXER_API_KEY=CHANGE_ME

# Limites Torznab générales
DEFAULT_LIMIT=100
MAX_LIMIT=200

# Pool PostgreSQL
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# AllDebrid
# Nécessaire uniquement pour le filtrage cache-only.
ALLDEBRID_API_KEY=CHANGE_ME

# Retourner uniquement les torrents présents dans le cache AllDebrid.
ALLDEBRID_CACHE_ONLY=true

# Limites de sécurité AllDebrid.
ALLDEBRID_CHECK_LIMIT=30
ALLDEBRID_BATCH_SIZE=10
ALLDEBRID_MAX_CHECK=30
