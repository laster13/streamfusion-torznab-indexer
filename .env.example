# ============================================================
# StreamFusion Torznab Indexer
# Configuration exemple
# ============================================================
#
# Copier ce fichier :
#
#   cp .env.example .env
#
# Puis remplacer toutes les valeurs "change_me".
#
# Ne jamais publier le fichier .env réel.
#
# Pour générer une clé aléatoire de 64 caractères :
#
#   openssl rand -hex 32
#
# Cette commande peut être utilisée pour :
#
#   INDEXER_API_KEY
#   MEILI_INDEXER_API_KEY
#   ALLDEBRID_BROKER_TOKEN
#
# ============================================================


# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------

# Image commune utilisée par les trois services :
#
#   sf-torznab
#   sf-torznab-meili
#   sf-alldebrid-broker
#
TORZNAB_IMAGE=laster13/streamfusion-torznab-indexer:latest

# Réseau Docker utilisé pour communiquer avec les services
# StreamFusion : PostgreSQL, Redis et Meilisearch.
#
# Cette valeur doit correspondre au réseau Docker existant
# de votre installation StreamFusion.
#
TORZNAB_NETWORK=sfr-dev


# ------------------------------------------------------------
# PostgreSQL StreamFusion
# ------------------------------------------------------------

# Connexion au PostgreSQL EXISTANT de StreamFusion.
#
# Adapter cette URL avec les valeurs réellement utilisées
# par votre installation StreamFusion :
#
#   utilisateur
#   mot de passe
#   nom du conteneur / hostname PostgreSQL
#   port
#   nom de la base
#
DATABASE_URL=postgresql+asyncpg://streamfusion:change_me@postgresql-dev:5432/streamfusion

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20


# ------------------------------------------------------------
# Indexeur PostgreSQL Torznab
# ------------------------------------------------------------

INDEXER_NAME=StreamFusion PostgreSQL

# Clé d'accès au Torznab PostgreSQL.
#
# Générer une clé :
#
#   openssl rand -hex 32
#
# Reporter EXACTEMENT la même valeur dans l'indexeur
# Generic Torznab PostgreSQL configuré dans Prowlarr.
#
INDEXER_API_KEY=change_me

DEFAULT_LIMIT=100
MAX_LIMIT=200


# ------------------------------------------------------------
# Indexeur Meilisearch Torznab
# ------------------------------------------------------------

# Clé d'accès au Torznab Meilisearch.
#
# Générer une clé :
#
#   openssl rand -hex 32
#
# Reporter EXACTEMENT la même valeur dans l'indexeur
# Generic Torznab Meilisearch configuré dans Prowlarr.
#
MEILI_INDEXER_API_KEY=change_me

# Clé utilisée pour accéder au Meilisearch de StreamFusion.
#
# Reprendre EXACTEMENT la même valeur que :
#
#   MEILI_MASTER_KEY
#
# configurée dans le .env de StreamFusion.
#
# Exemple :
#
#   StreamFusion :
#     MEILI_MASTER_KEY=devMasterKey
#
#   Torznab :
#     MEILI_TORZNAB_SEARCH_KEY=devMasterKey
#
MEILI_TORZNAB_SEARCH_KEY=change_me


# ------------------------------------------------------------
# AllDebrid
# ------------------------------------------------------------

# Clé API de votre compte AllDebrid.
#
# Cette valeur provient d'AllDebrid.
# Ne pas la générer avec openssl.
#
ALLDEBRID_API_KEY=change_me

ALLDEBRID_CACHE_ONLY=false
ALLDEBRID_CHECK_LIMIT=30
ALLDEBRID_BATCH_SIZE=10
ALLDEBRID_MAX_CHECK=30


# ------------------------------------------------------------
# Broker AllDebrid interne
# ------------------------------------------------------------

# Secret interne partagé entre :
#
#   sf-torznab
#   sf-torznab-meili
#   sf-alldebrid-broker
#
# Les trois services utilisent automatiquement cette même
# variable via le docker-compose.yml fourni.
#
# Générer une clé :
#
#   openssl rand -hex 32
#
ALLDEBRID_BROKER_TOKEN=change_me
